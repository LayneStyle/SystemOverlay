<Window x:Class="SystemOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Overlay — Settings"
        Width="380" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2E">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="#00D4FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SliderLabel">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="Slider" x:Key="ThresholdSlider">
            <Setter Property="Minimum" Value="50"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="TickFrequency" Value="5"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General -->
                <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="ChkAutoStart" Content="Start with Windows"/>

                <!-- Visible Metrics -->
                <TextBlock Text="VISIBLE METRICS" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="ChkCpu" Content="CPU (Usage + Temperature)"/>
                <CheckBox x:Name="ChkGpu" Content="GPU (Usage + Temperature)"/>
                <CheckBox x:Name="ChkRam" Content="RAM (Used / Total)"/>
                <CheckBox x:Name="ChkNet" Content="Network (Upload / Download)"/>
                <CheckBox x:Name="ChkDisk" Content="Disks (Space Used)"/>

                <!-- Appearance -->
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>

                <TextBlock Style="{StaticResource SliderLabel}">
                    <Run Text="Text Size: "/><Run x:Name="FontScaleVal" Text="100"/>%
                </TextBlock>
                <Slider x:Name="SliderFontScale" Minimum="80" Maximum="150"
                        TickFrequency="10" IsSnapToTickEnabled="True"
                        ValueChanged="OnAppearanceSliderChanged"/>

                <!-- Threshold Alerts -->
                <TextBlock Text="THRESHOLD ALERTS" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="ChkAlerts" Content="Enable alerts (forces overlay to front)"/>

                <TextBlock Style="{StaticResource SliderLabel}">
                    <Run Text="CPU Usage: "/><Run x:Name="CpuUsageVal" Text="90"/>%
                </TextBlock>
                <Slider x:Name="SliderCpuUsage" Style="{StaticResource ThresholdSlider}"
                        ValueChanged="OnSliderChanged"/>

                <TextBlock Style="{StaticResource SliderLabel}">
                    <Run Text="CPU Temp: "/><Run x:Name="CpuTempVal" Text="95"/>°C
                </TextBlock>
                <Slider x:Name="SliderCpuTemp" Style="{StaticResource ThresholdSlider}"
                        Minimum="60" Maximum="105" ValueChanged="OnSliderChanged"/>

                <TextBlock Style="{StaticResource SliderLabel}">
                    <Run Text="GPU Usage: "/><Run x:Name="GpuUsageVal" Text="95"/>%
                </TextBlock>
                <Slider x:Name="SliderGpuUsage" Style="{StaticResource ThresholdSlider}"
                        ValueChanged="OnSliderChanged"/>

                <TextBlock Style="{StaticResource SliderLabel}">
                    <Run Text="GPU Temp: "/><Run x:Name="GpuTempVal" Text="90"/>°C
                </TextBlock>
                <Slider x:Name="SliderGpuTemp" Style="{StaticResource ThresholdSlider}"
                        Minimum="60" Maximum="105" ValueChanged="OnSliderChanged"/>

                <TextBlock Style="{StaticResource SliderLabel}">
                    <Run Text="RAM Usage: "/><Run x:Name="RamUsageVal" Text="90"/>%
                </TextBlock>
                <Slider x:Name="SliderRamUsage" Style="{StaticResource ThresholdSlider}"
                        ValueChanged="OnSliderChanged"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0" Click="OnCancel"
                    Background="#333344" Foreground="#AAFFFFFF" BorderThickness="0" FontFamily="Segoe UI"/>
            <Button Content="Save" Padding="20,6" Click="OnSave"
                    Background="#00D4FF" Foreground="#111" FontWeight="SemiBold" BorderThickness="0" FontFamily="Segoe UI"/>
        </StackPanel>
    </Grid>
</Window>
