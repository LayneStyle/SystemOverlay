<Window x:Class="SystemOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SystemOverlay.Converters"
        Title="System Overlay"
        Icon="Assets/icon.ico"
        Width="280" MinWidth="200" MinHeight="120"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Accent colors -->
        <Color x:Key="AccentCyan">#00D4FF</Color>
        <Color x:Key="AccentGreen">#00FF88</Color>
        <Color x:Key="AccentOrange">#FF8800</Color>
        <Color x:Key="AccentPink">#FF3388</Color>
        <Color x:Key="AccentPurple">#AA66FF</Color>
        <Color x:Key="AlertRed">#FF2244</Color>

        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource AccentCyan}"/>
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource AccentGreen}"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource AccentOrange}"/>
        <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource AccentPink}"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource AccentPurple}"/>
        <SolidColorBrush x:Key="AlertBrush" Color="{StaticResource AlertRed}"/>
        <SolidColorBrush x:Key="DimText" Color="#77FFFFFF"/>
        <SolidColorBrush x:Key="ProcessText" Color="#99FFFFFF"/>

        <!-- Progress bar style -->
        <Style x:Key="MetricBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label style -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Expand button style -->
        <Style x:Key="ExpandBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#55FFFFFF"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Process row style -->
        <Style x:Key="ProcessRow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="8,1,0,0"/>
        </Style>
    </Window.Resources>

    <!-- Context Menu -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="⚙ Settings" Click="OnSettingsClick"/>
            <MenuItem Header="📌 Pin On Top" x:Name="PinMenuItem" Click="OnPinToggle" IsCheckable="True" IsChecked="True"/>
            <Separator/>
            <MenuItem Header="✕ Exit" Click="OnExitClick"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Main container -->
    <Border x:Name="MainBorder"
            CornerRadius="12"
            Padding="14,10,14,12"
            MouseLeftButtonDown="OnDragMove">
        <Border.Background>
            <SolidColorBrush Color="#1A1A2E" Opacity="0.92"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Pin & Close -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="S Y S T E M   O V E R L A Y" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"
                               FontFamily="Segoe UI"/>
                    <Button x:Name="PinButton" Grid.Column="1" Content="📌" FontSize="12"
                            Click="OnPinToggle" ToolTip="Toggle Always on Top"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            Cursor="Hand" Padding="4,2" Margin="0,0,4,0" Opacity="1"/>
                    <Button Grid.Column="2" Content="✕" FontSize="12"
                            Click="OnExitClick"
                            Background="Transparent" BorderThickness="0" Foreground="#66FFFFFF"
                            Cursor="Hand" Padding="4,2"/>
                </Grid>

                <!-- CPU Section -->
                <Border Grid.Row="1" x:Name="CpuSection" Margin="0,0,0,6"
                        Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" Style="{StaticResource MetricLabel}"
                                       Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Style="{StaticResource ExpandBtn}"
                                    x:Name="CpuExpandBtn" Click="OnToggleCpuProcesses" Content="▶" Margin="6,0,0,0"/>
                            <TextBlock x:Name="CpuText" Grid.Column="3" Text="{Binding CpuText}" Style="{StaticResource MetricValue}"/>
                        </Grid>
                        <ProgressBar x:Name="CpuBar" Value="{Binding CpuValue}" Foreground="{Binding CpuBarForeground}" Style="{StaticResource MetricBar}"/>
                        <TextBlock x:Name="CpuTempText" Text="{Binding CpuTempText}" Style="{StaticResource MetricLabel}" Margin="0,2,0,0"/>
        <!-- Top processes (hidden by default) -->
                        <ItemsControl x:Name="CpuProcessPanel" ItemsSource="{Binding CpuProcesses}" Visibility="Collapsed" Margin="0,3,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name, StringFormat='  \{0\}'}" Style="{StaticResource ProcessRow}" Foreground="#88FFFFFF"/>
                                        <TextBlock Text="{Binding Value, StringFormat='\{0:F0\} CPU time'}" Foreground="#AAFFFFFF" HorizontalAlignment="Right" Grid.Column="1">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ProcessRow}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- GPU Section -->
                <Border Grid.Row="2" x:Name="GpuSection" Margin="0,0,0,6"
                        Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU" Style="{StaticResource MetricLabel}"
                                       Foreground="{StaticResource GreenBrush}" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Style="{StaticResource ExpandBtn}"
                                    x:Name="GpuExpandBtn" Click="OnToggleGpuProcesses" Content="▶" Margin="6,0,0,0"/>
                            <TextBlock x:Name="GpuText" Grid.Column="3" Text="{Binding GpuText}" Style="{StaticResource MetricValue}"/>
                        </Grid>
                        <ProgressBar x:Name="GpuBar" Value="{Binding GpuValue}" Foreground="{Binding GpuBarForeground}" Style="{StaticResource MetricBar}"/>
                        <TextBlock x:Name="GpuTempText" Text="{Binding GpuTempText}" Style="{StaticResource MetricLabel}" Margin="0,2,0,0"/>
                        <ItemsControl x:Name="GpuProcessPanel" ItemsSource="{Binding GpuProcesses}" Visibility="Collapsed" Margin="0,3,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name, StringFormat='  \{0\}'}" Style="{StaticResource ProcessRow}" Foreground="#88FFFFFF"/>
                                        <TextBlock Text="{Binding Value, StringFormat='\{0:F0\} %'}" Foreground="#AAFFFFFF" HorizontalAlignment="Right" Grid.Column="1">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ProcessRow}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- RAM Section -->
                <Border Grid.Row="3" x:Name="RamSection" Margin="0,0,0,6"
                        Visibility="{Binding ShowRam, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RAM" Style="{StaticResource MetricLabel}"
                                       Foreground="{StaticResource OrangeBrush}" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Style="{StaticResource ExpandBtn}"
                                    x:Name="RamExpandBtn" Click="OnToggleRamProcesses" Content="▶" Margin="6,0,0,0"/>
                            <TextBlock x:Name="RamText" Grid.Column="3" Text="{Binding RamText}" Style="{StaticResource MetricValue}"/>
                        </Grid>
                        <ProgressBar x:Name="RamBar" Value="{Binding RamValue}" Foreground="{Binding RamBarForeground}" Style="{StaticResource MetricBar}"/>
                        <ItemsControl x:Name="RamProcessPanel" ItemsSource="{Binding RamProcesses}" Visibility="Collapsed" Margin="0,3,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name, StringFormat='  \{0\}'}" Style="{StaticResource ProcessRow}" Foreground="#88FFFFFF"/>
                                        <TextBlock Text="{Binding Value, StringFormat='\{0:F0\} MB'}" Foreground="#AAFFFFFF" HorizontalAlignment="Right" Grid.Column="1">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ProcessRow}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Network Section -->
                <Border Grid.Row="4" x:Name="NetSection" Margin="0,0,0,6"
                        Visibility="{Binding ShowNetwork, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="NETWORK" Style="{StaticResource MetricLabel}"
                                   Foreground="{StaticResource PinkBrush}" FontWeight="SemiBold"/>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NetUpText" Text="{Binding NetUpText}" Style="{StaticResource MetricLabel}" FontSize="11"/>
                            <TextBlock x:Name="NetDownText" Grid.Column="1" Text="{Binding NetDownText}" Style="{StaticResource MetricLabel}"
                                       FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Disk Section -->
                <Border Grid.Row="5" x:Name="DiskSection"
                        Visibility="{Binding ShowDisk, Converter={StaticResource BoolToVis}}">
                    <StackPanel x:Name="DiskPanel">
                        <TextBlock Text="DISKS" Style="{StaticResource MetricLabel}"
                                   Foreground="{StaticResource PurpleBrush}" FontWeight="SemiBold"
                                   Margin="0,0,0,3"/>
                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Disk Name & Activity -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource MetricLabel}" Foreground="#99FFFFFF"/>
                                            <TextBlock Text="{Binding ReadMBps, StringFormat=' R:{0:F1}'}" Foreground="#55FFFFFF" FontSize="9">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReadMBps}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding WriteMBps, StringFormat=' W:{0:F1}'}" Foreground="#55FFFFFF" FontSize="9">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WriteMBps}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Bar -->
                                        <ProgressBar Grid.Column="1" Value="{Binding UsagePercent, Mode=OneWay}" VerticalAlignment="Center">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource MetricBar}">
                                                    <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AlertBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>

                                        <!-- Usage -->
                                        <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource MetricLabel}" Foreground="#C8FFFFFF" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:F0} / {1:F0} GB">
                                                    <Binding Path="UsedGb"/>
                                                    <Binding Path="TotalGb"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
</Window>
